POSTGRES_USER=finapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finapp
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_SSLMODE=disable
HTTP_ADDR=:8080
# Sites que podem chamar a API pelo navegador (o front web em outro domínio/túnel), separados por vírgula.
# Vazio: só funciona com o front no mesmo endereço (proxy /api do Vite).
# CORS_ALLOWED_ORIGINS=https://seu-front.trycloudflare.com
# Fuso usado em "hoje", vencimentos e meses da projeção (a imagem Docker já usa este)
# TZ=America/Sao_Paulo
# Alternativa aos campos POSTGRES_*; tem precedência quando definida:
# DATABASE_URL=postgres://finapp:change-me@localhost:5432/finapp?sslmode=disable
# Banco exclusivo para integração (deve existir):
# TEST_DATABASE_URL=postgres://finapp:change-me@localhost:5432/finapp_test?sslmode=disable
# Cache das respostas (opcional): sem ele a API funciona direto no banco. make docker-up sobe o Redis.
REDIS_URL=redis://localhost:6379/0
# Porta do Redis no seu computador, se a 6379 já estiver em uso (ajuste a REDIS_URL junto):
# REDIS_PORT=6379
# Redis para os testes do cache (o teste pula sem ela):
# TEST_REDIS_URL=redis://localhost:6379/15
APP_VERSION=latest
FINAPP_PORT=8080
# Envio do código de recuperação de senha. Sem SMTP_HOST o código vai para o log, o que só é aceito
# fora de produção: com GIN_MODE=release a API não sobe sem SMTP_HOST.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=finapp@example.com
